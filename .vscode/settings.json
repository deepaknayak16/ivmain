// Claude
{
  // ─────────────────────────────────────────────
  //  WINDOW & WORKBENCH
  // ─────────────────────────────────────────────
  "window.autoDetectColorScheme": true,
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "window.closeWhenEmpty": false,
  "window.newWindowDimensions": "inherit",
  "window.openFilesInNewWindow": "off",
  "window.openFoldersInNewWindow": "on",
  "window.restoreFullscreen": false,
  "window.restoreWindows": "all",
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}${separator}${profileName}",
  "window.zoomLevel": 0,
  // ─────────────────────────────────────────────
  //  WORKBENCH LAYOUT
  // ─────────────────────────────────────────────
  "workbench.activityBar.location": "top",
  "workbench.activityBar.autoHide": false,
  "workbench.activityBar.compact": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.alwaysShowEditorActions": false,
  "workbench.editor.tabSizing": "fit", //srink
  "workbench.editor.wrapTabs": false,
  "workbench.editor.pinnedTabsOnSeparateRow": true,
  "workbench.sideBar.location": "left",
  "workbench.statusBar.visible": true,
  "workbench.view.alwaysShowHeaderActions": true,
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "workbench.layoutControl.enabled": false,
  "workbench.view.showQuietly": {
    "workbench.panel.output": true
  },
  // ─────────────────────────────────────────────
  //  WORKBENCH COLORS (Catppuccin Mocha palette)
  // ─────────────────────────────────────────────
  "workbench.colorCustomizations": {
    // Status bar — base
    "statusBar.background": "#11111b",
    "statusBar.foreground": "#cdd6f4",
    "statusBar.border": "#313244",
    "statusBar.hoverForeground": "#89b4fa",
    "statusBar.focusBorder": "#89b4fa",
    // Status bar — states
    "statusBar.debuggingBackground": "#f38ba8",
    "statusBar.debuggingForeground": "#11111b",
    "statusBar.noFolderBackground": "#181825",
    "statusBar.noFolderForeground": "#585b70",
    // Status bar items
    "statusBarItem.hoverBackground": "#313244",
    "statusBarItem.activeBackground": "#45475a",
    "statusBarItem.remoteBackground": "#89b4fa",
    "statusBarItem.remoteForeground": "#11111b",
    // Editor chrome
    "editorGroupHeader.tabsBackground": "#11111b",
    "editorGroupHeader.tabsBorder": "#313244",
    "tab.activeBackground": "#1e1e2e",
    "tab.inactiveBackground": "#11111b",
    "tab.activeBorderTop": "#89b4fa",
    "tab.activeForeground": "#cdd6f4",
    "tab.inactiveForeground": "#585b70",
    // Title bar
    "titleBar.activeBackground": "#11111b",
    "titleBar.activeForeground": "#cdd6f4",
    "titleBar.inactiveBackground": "#11111b",
    "titleBar.border": "#313244",
    // Activity bar
    "activityBar.background": "#11111b",
    "activityBar.foreground": "#cdd6f4",
    "activityBar.inactiveForeground": "#585b70",
    "activityBar.activeBorder": "#89b4fa",
    "activityBar.border": "#313244",
    // Side bar
    "sideBar.background": "#181825",
    "sideBar.foreground": "#cdd6f4",
    "sideBar.border": "#313244",
    "sideBarTitle.foreground": "#7f849c",
    "sideBarSectionHeader.background": "#181825",
    "sideBarSectionHeader.foreground": "#7f849c",
    "sideBarSectionHeader.border": "#313244",
    // Panel (terminal, output)
    "panel.background": "#11111b",
    "panel.border": "#313244",
    "panelTitle.activeForeground": "#89b4fa",
    "panelTitle.inactiveForeground": "#585b70",
    "panelTitle.activeBorder": "#89b4fa"
  },
  // ─────────────────────────────────────────────
  //  EDITOR — TYPOGRAPHY
  // ─────────────────────────────────────────────
  "editor.fontFamily": "'Jetrains Mono', 'Fira Code', 'Cascadia Code', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.4,
  "editor.letterSpacing": 0.5,
  "editor.fontWeight": "450",
  // ─────────────────────────────────────────────
  //  EDITOR — CURSOR & SELECTION
  // ─────────────────────────────────────────────
  "editor.cursorBlinking": "smooth", //phase
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 3,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorHeight": 100,
  "editor.multiCursorModifier": "ctrlCmd",
  // ─────────────────────────────────────────────
  //  EDITOR — VISUAL GUIDES
  // ─────────────────────────────────────────────
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "trailing",
  "editor.renderLineHighlight": "gutter",
  "editor.guides.indentation": false,
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveIndentation": false,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.smoothScrolling": true,
  // ─────────────────────────────────────────────
  //  EDITOR — CODE INTELLIGENCE
  // ─────────────────────────────────────────────
  "editor.autoIndent": "full",
  "editor.autoIndentOnPaste": true,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": true,
  "editor.trimAutoWhitespace": true,
  "editor.wordWrap": "off",
  "editor.linkedEditing": true,
  "editor.suggest.preview": true,
  "editor.suggest.showStatusBar": true,
  "editor.inlineSuggest.enabled": true,
  "editor.parameterHints.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "off"
  },
  // ─────────────────────────────────────────────
  //  EDITOR — INLAY HINTS & LENS
  // ─────────────────────────────────────────────
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.codeLens": false,
  // ─────────────────────────────────────────────
  //  BREADCRUMBS & NAVIGATION
  // ─────────────────────────────────────────────
  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "last",
  "breadcrumbs.filePath": "last",
  // ─────────────────────────────────────────────
  //  TERMINAL
  // ─────────────────────────────────────────────
  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.6,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.tabs.enabled": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "zsh",
  // ─────────────────────────────────────────────
  //  FILE MANAGEMENT
  // ─────────────────────────────────────────────
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  // ─────────────────────────────────────────────
  //  EXPLORER
  // ─────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "type",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": { // =========================
    // TYPESCRIPT
    // =========================
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.map, ${capture}.test.ts, ${capture}.spec.ts",
    "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.styles.ts",
    // =========================
    // JAVASCRIPT
    // =========================
    "*.js": "${capture}.min.js, ${capture}.map, ${capture}.test.js, ${capture}.spec.js",
    "*.jsx": "${capture}.test.jsx, ${capture}.spec.jsx",
    // =========================
    // REACT
    // =========================
    "index.tsx": "index.module.css, index.module.scss, index.test.tsx",
    "App.tsx": "App.css, App.scss, App.test.tsx",
    // =========================
    // HTML / CSS
    // =========================
    "*.html": "${capture}.css, ${capture}.scss, ${capture}.js",
    "*.css": "${capture}.map, ${capture}.min.css",
    "*.scss": "${capture}.css, ${capture}.map",
    // =========================
    // ANGULAR
    // =========================
    "*.component.ts": "${capture}.component.html, ${capture}.component.scss, ${capture}.component.css, ${capture}.component.spec.ts",
    "*.service.ts": "${capture}.service.spec.ts",
    "*.directive.ts": "${capture}.directive.spec.ts",
    "*.pipe.ts": "${capture}.pipe.spec.ts",
    // =========================
    // PYTHON
    // =========================
    "*.py": "${capture}.pyc, ${capture}.pyo, ${capture}.log, ${capture}.spec.py, ${capture}_test.py",
    "requirements.txt": "requirements-dev.txt, requirements-prod.txt",
    "pyproject.toml": "poetry.lock",
    // =========================
    // ENV FILES
    // =========================
    ".env": ".env.*, .venv, venv",
    // =========================
    // PACKAGE + CONFIGS
    // =========================
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, .npmrc, .nvmrc, .eslint*, .prettier*, tsconfig*, vite.config.*, webpack.config.*, tailwind.config.*, postcss.config.*, babel.config.*",
    // =========================
    // DOCKER
    // =========================
    "docker-compose.yml": "Dockerfile, .dockerignore",
    // =========================
    // README + DOCS
    // =========================
    "README.md": "LICENSE, CONTRIBUTING.md, CHANGELOG.md",
  },
  // ─────────────────────────────────────────────
  //  SEARCH
  // ─────────────────────────────────────────────
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/.git": true
  },
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true
}
//Token	Color	Hex
// Background	Black	#000000
// Foreground	Off-white	#f7f1ff
// Strings	Yellow	#fce566
// Keywords	Pink	#fc618d
// Functions	Green	#7bd88f
// Comments	Gray	#69676c
// Types	Cyan	#5ad4e6
// Constants	Purple	#948ae3
// Parameters	Orange	#fd9353
